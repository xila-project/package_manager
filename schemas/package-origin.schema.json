{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/package-origin.schema.json",
  "title": "Xila installed package origin (experimental v2)",
  "description": "Where an installed package came from. Registry updates require the same repository and a continuous package key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "repository",
    "name",
    "version",
    "archive_sha256"
  ],
  "properties": {
    "$schema": {
      "description": "Optional editor-facing schema URL; not a trust anchor.",
      "anyOf": [
        {
          "const": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/package-origin.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "format_version": {
      "const": 2
    },
    "repository": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        }
      ],
      "description": "Configured repository name, or null for a local archive."
    },
    "name": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?){2,}$",
      "description": "Stable reverse-DNS package identifier with at least three lowercase components."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_key": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "public_key"
          ],
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33
            },
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$",
              "description": "Canonical base64 encoding of a raw 32-byte Ed25519 public key."
            }
          }
        }
      ]
    }
  },
  "if": {
    "properties": {
      "repository": {
        "type": "string"
      }
    }
  },
  "then": {
    "required": [
      "package_key"
    ],
    "properties": {
      "package_key": {
        "type": "object"
      }
    }
  }
}

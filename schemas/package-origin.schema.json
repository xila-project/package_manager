{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/package-origin.schema.json",
  "title": "Xila installed package origin (experimental v1)",
  "description": "Where an installed package came from. Updates are only accepted from the same repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "repository",
    "name",
    "version",
    "archive_sha256"
  ],
  "properties": {
    "$schema": {
      "description": "Optional editor-facing schema URL; not a trust anchor.",
      "anyOf": [
        {
          "const": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/package-origin.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "format_version": {
      "const": 1
    },
    "repository": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        }
      ],
      "description": "Configured repository name, or null for a local archive."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/registry-index.schema.json",
  "title": "Xila registry index (experimental v2)",
  "description": "Signed snapshot of registry entries and package key rotation records. The file list is sorted by path without duplicates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "version",
    "expires",
    "files"
  ],
  "properties": {
    "$schema": {
      "description": "Optional editor-facing schema URL; not a trust anchor.",
      "anyOf": [
        {
          "const": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/registry-index.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "format_version": {
      "const": 2
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Strictly increasing between publications (signing time in Unix seconds)."
    },
    "expires": {
      "type": "integer",
      "minimum": 2,
      "description": "Expiry in Unix seconds (UTC); greater than version."
    },
    "files": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(packages|rotations)(/[A-Za-z0-9._+-]+)+\\.json$",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        }
      }
    }
  }
}

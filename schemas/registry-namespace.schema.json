{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/registry-namespace.schema.json",
  "title": "Xila namespace ownership claim (experimental version 2)",
  "description": "Ownership claim checked at first package publication. The registry submission process must verify the domain or account independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "namespace",
    "owner"
  ],
  "properties": {
    "$schema": {
      "description": "Optional editor-facing schema URL; not a trust anchor.",
      "anyOf": [
        {
          "const": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/registry-namespace.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "format_version": {
      "const": 2
    },
    "namespace": {
      "type": "string",
      "maxLength": 94,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?)+$",
      "description": "Exact namespace of the package identifier, excluding its final component."
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "domain",
            "github",
            "gitlab"
          ],
          "description": "How registry CI proves ownership."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 94,
          "description": "The domain (xila.example for example.xila) or the account (alice for io.github.alice)."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "owner": {
            "properties": {
              "kind": {
                "const": "github"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "pattern": "^io\\.github\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner": {
            "properties": {
              "kind": {
                "const": "gitlab"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "pattern": "^io\\.gitlab\\.[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner": {
            "properties": {
              "kind": {
                "const": "domain"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "not": {
              "pattern": "^io\\.(github|gitlab)(?:\\.|$)|_"
            }
          },
          "owner": {
            "properties": {
              "name": {
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
              }
            }
          }
        }
      }
    }
  ]
}

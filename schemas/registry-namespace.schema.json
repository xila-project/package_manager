{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/registry-namespace.schema.json",
  "title": "Xila registry namespace (experimental v1)",
  "description": "namespaces/<namespace>.json in xila-project/registry, signed (.sig) by a repository key. Records the owner of a reverse-DNS namespace and the developer keys allowed to publish in it: a listed key may publish every identifier that starts with the namespace's components (org.example covers org.example.weather and org.example.tools.clock). Namespace files may not overlap, and every listed key must exist in keys/developers. The owner must match the namespace: a domain is the namespace reversed (org.example is owned by example.org), and io.github.<account> or io.gitlab.<account> is owned by that account. Registry CI proves the ownership: a domain by a token file under https://<domain>/.well-known/, an account by the account itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "namespace",
    "owner",
    "developer_keys"
  ],
  "properties": {
    "$schema": {
      "description": "Optional editor-facing schema URL; not a trust anchor.",
      "anyOf": [
        {
          "const": "https://raw.githubusercontent.com/xila-project/package_manager/main/schemas/registry-namespace.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "format_version": {
      "const": 1,
      "description": "Experimental namespace file format version 1."
    },
    "namespace": {
      "type": "string",
      "maxLength": 94,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?)+$",
      "description": "Reverse-DNS namespace with at least two lowercase components; also the file name. The legacy xila namespace has no namespace file."
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "domain",
            "github",
            "gitlab"
          ],
          "description": "How registry CI proves ownership."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 94,
          "description": "The domain (example.org for org.example) or the account (alice for io.github.alice)."
        }
      }
    },
    "developer_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "description": "Identifiers of the developer keys (keys/developers/<id>.json) allowed to publish in this namespace."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "owner": {
            "properties": {
              "kind": {
                "const": "github"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "pattern": "^io\\.github\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner": {
            "properties": {
              "kind": {
                "const": "gitlab"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "pattern": "^io\\.gitlab\\.[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner": {
            "properties": {
              "kind": {
                "const": "domain"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "not": {
              "pattern": "^io\\.(github|gitlab)\\.|_"
            }
          },
          "owner": {
            "properties": {
              "name": {
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
              }
            }
          }
        }
      }
    }
  ]
}
